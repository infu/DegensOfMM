service : () -> {
  accept_quest : (text, text, text) -> (Result);
  cast_adventure_spell : (text, text, text, text) -> (Result);
  claim_quest_reward : (text, text, text) -> (Result);
  create_session : (text, text, nat64, text) -> (Result_1);
  end_battle_turn : (text, text, text) -> (Result);
  end_turn : (text, text) -> (Result);
  force_diagnostic_system_job_running : (text, nat64) -> (Result_2);
  get_battle_state : (text, text) -> (Result_3) query;
  get_canister_endpoint_inventory : () -> (vec CanisterEndpointView) query;
  get_champion_view : (text, text) -> (Result_4) query;
  get_command_status : (text, text) -> (Result_5) query;
  get_command_status_by_nonce : (text, text, text) -> (Result_5) query;
  get_content_manifest : (text, nat32) -> (Result_6) query;
  get_diagnostic_projection_snapshot : () -> (Result_7) query;
  get_diagnostic_storage_snapshot : (vec text) -> (Result_8) query;
  get_diagnostic_system_jobs : (opt text, opt text, nat32, opt text) -> (
      Result_9,
    ) query;
  get_dwelling_pool : (text, text) -> (Result_10) query;
  get_events_after : (text, text, nat64, nat32) -> (Result_11) query;
  get_game_view : (text, GameViewRequest) -> (Result_12) query;
  get_match_history : (nat32, nat32) -> (Result_13) query;
  get_my_champions : (text) -> (Result_14) query;
  get_my_participant : (text) -> (Result_15) query;
  get_my_player : () -> (Result_16) query;
  get_naval_routes : (text) -> (Result_17) query;
  get_object_view : (text, text, text) -> (Result_18) query;
  get_objective_progress : (text) -> (Result_19) query;
  get_procedural_map_state : (text) -> (Result_20) query;
  get_scenario_rules : (text) -> (Result_21) query;
  get_session : (text) -> (Result_22) query;
  get_setup_progress : (text) -> (Result_23) query;
  get_siege_rules : (text) -> (Result_24) query;
  get_skirmish_settings : (text) -> (Result_25) query;
  get_tavern_offers : (text, text) -> (Result_26) query;
  get_town_view : (text, text) -> (Result_27) query;
  get_visible_map_chunks : (text, Viewport, opt nat32, nat32) -> (
      Result_28,
    ) query;
  get_visible_objects : (text, Viewport, opt nat32, nat32) -> (Result_29) query;
  get_world_events : (text) -> (Result_30) query;
  hire_tavern_champion : (text, text, text, text) -> (Result);
