type QueryErrorKind = variant {
  // Planning failed.
  Plan;
  // No rows matched.
  NotFound;
  // More than one row matched.
  NotUnique;
  // Pagination lacked ordering.
  UnorderedPagination;
  // Continuation cursor was invalid.
  InvalidContinuationCursor;
  // Intent validation failed.
  Intent;
  // Validation failed.
  Validate;
};
