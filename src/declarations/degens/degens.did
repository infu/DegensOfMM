type ActionAffordance = record {
  action : text;
  target_id : opt text;
  enabled : bool;
  disabled_reason : opt text;
};
type AdvancedScenarioReceipt = record {
  event_key : opt text;
  rule_key : opt text;
  action : text;
  command_id : text;
  resources_after : opt ResourceBalances;
  reward_gold : nat32;
  state : text;
  quest_key : opt text;
  current_turn : nat32;
  objective_key : opt text;
};
type ApiError = record {
  code : text;
  details_json : opt text;
  message : text;
  retryable : bool;
};
type ApiEventPage = record {
  page_info : EventPageInfo;
  events : vec ApiEventView;
};
type ApiEventView = record {
  event_key : text;
  event_seq : nat64;
  session_id : text;
  subject_kind : opt text;
  turn_number : nat32;
  audience_key : text;
  subject_id_text : opt text;
  event_type : text;
  payload : opt text;
  redacted : bool;
};
type ApiTownView = record {
  town : TownRecord;
  garrison_stacks : vec ArmyStackRecord;
  recruit_pools : vec TownRecruitPoolRecord;
  buildings : vec TownBuildingRecord;
};
type ArmyStackRecord = record {
  status : text;
  session_id : text;
  front_hp : nat16;
  unit_slug : text;
  owner_id : text;
  stack_id : text;
  quantity : nat32;
  slot_index : nat8;
  last_command_id : opt text;
  owner_kind : text;
};
type ArtifactContent = record {
  id : text;
  ruleset_id : text;
  name : text;
  slot : text;
  slug : text;
  description : opt text;
  icon_key : opt text;
  rarity : text;
  effect_key : text;
};
type ArtifactView = record {
  artifact_id : text;
  artifact_def_id : text;
  slot : text;
  state : text;
};
type BattleActionInput = record {
  destination : opt BattleCoord;
  action : text;
  battle_id : text;
  battle_stack_id : text;
  ability_key : opt text;
  target_stack_id : opt text;
};
type BattleActionReceipt = record {
  event_seq : opt nat64;
  status : text;
  command_id : text;
  active_stack_id : opt text;
  current_round : nat16;
};
type BattleCoord = record { x : nat8; y : nat8 };
type BattleEventView = record {
  event_key : text;
  event_seq : nat64;
  subject_id_text : text;
  event_type : text;
  payload : text;
};
type BattleGridView = record { height : nat8; width : nat8 };
type BattleMoraleLuckPolicy = record {
  morale_disabled_reason : opt text;
  morale_enabled : bool;
  luck_enabled : bool;
  luck_disabled_reason : opt text;
};
type BattleObstacleView = record {
  hp : nat16;
  height : nat8;
  battle_x : nat8;
  battle_y : nat8;
  obstacle_type : text;
  battle_obstacle_id : text;
  state : text;
  width : nat8;
};
type BattleStackView = record {
  status : text;
  shots_remaining : nat16;
  owner_participant_id : opt text;
  battle_x : nat8;
  battle_y : nat8;
  flying : bool;
  side : text;
  battle_stack_id : text;
  champion_guard : int16;
  front_hp : nat16;
  defended_round : nat16;
  acted_round : nat16;
  speed : nat8;
  waited_round : nat16;
  defense : int16;
  quantity : nat32;
  ranged : bool;
  damage_max : nat16;
  damage_min : nat16;
  champion_might : int16;
  max_hp : nat16;
  unit_id : text;
  status_keys : vec text;
  attack : int16;
  initiative : nat8;
};
type BattleStartDraft = record {
  x : nat16;
  y : nat16;
  attacker_champion_id : text;
  defender_id_text : text;
  defender_kind : text;
  battle_type : text;
  battle_key : text;
};
type BattleSummary = record {
  battle_id : text;
  active_participant_id : opt text;
  active_stack_id : opt text;
  state : text;
  current_round : nat16;
  battle_type : text;
};
type BattleSyncOutcome = record {
  battle_id : text;
  battle_sync_incomplete : bool;
  active_stack_id : opt text;
  timeout_actions_applied : nat32;
  recovered_commands : nat32;
};
type BattleView = record {
  stacks : vec BattleStackView;
  legal_actions_for_caller : vec LegalBattleAction;
  battle_id : text;
  grid : BattleGridView;
  active_participant_id : opt text;
  action_deadline_at : opt nat64;
  active_stack_id : opt text;
  state : text;
  obstacles : vec BattleObstacleView;
  initiative_order : vec text;
  events : vec BattleEventView;
  current_round : nat16;
  battle_type : text;
  next_event_seq : nat64;
  remaining_ms : opt nat64;
  morale_luck_policy : BattleMoraleLuckPolicy;
};
type BuildPreview = record {
  town_id : text;
  cost : ResourceBalances;
  allowed : bool;
  building_slug : text;
  disabled_reason : opt text;
};
type BuildingContent = record {
  id : text;
  ruleset_id : text;
  cost : ResourceCost;
  name : text;
  slug : text;
  description : opt text;
  faction_slug : opt text;
  icon_key : opt text;
  requires_building_slugs : vec text;
  building_type : text;
  effect_key : opt text;
  unlocks_unit_slug : opt text;
};
type CanisterEndpointView = record {
  kind : EndpointKind;
  name : text;
  group : text;
  fixture_mapping : text;
};
type ChampionArmyStackRecord = record {
  status : text;
  session_id : text;
  front_hp : nat16;
  unit_slug : text;
  stack_id : text;
  champion_id : text;
  quantity : nat32;
  slot_index : nat8;
  last_command_id : opt text;
};
type ChampionClassContent = record {
  id : text;
  ruleset_id : text;
  portrait_key : opt text;
  name : text;
  slug : text;
  description : opt text;
  faction_slug : opt text;
  base_movement : nat16;
  base_vision : nat8;
};
type ChampionHirePreview = record {
  town_id : text;
  offer_key : text;
  cost : ResourceBalances;
  allowed : bool;
  candidate_name : text;
  disabled_reason : opt text;
  champion_class_slug : text;
};
type ChampionMagicReceipt = record {
  action : text;
  mana_after : nat16;
  command_id : text;
  skill_key : opt text;
  champion_id : text;
  status_keys : vec text;
  movement_remaining_after : nat16;
  spell_slug : opt text;
};
type ChampionProgressionView = record {
  mana_turn : nat32;
  mana_max : nat16;
  mana : nat16;
  level : nat16;
  experience : nat64;
  learned_spell_slugs : vec text;
  champion_id : text;
  skill_keys : vec text;
  skill_points : nat16;
  level_up_choices : vec ChampionSkillChoiceView;
};
type ChampionSkillChoiceView = record {
  name : text;
  rank : nat8;
  skill_key : text;
  description : text;
  enabled : bool;
  disabled_reason : opt text;
};
type ChampionView = record {
  x : nat16;
  y : nat16;
  status : text;
  vision_radius : nat8;
  owner_participant_id : text;
  mana_max : nat16;
  artifacts : vec ArtifactView;
  mana : nat16;
  name : opt text;
  spell_slugs : vec text;
  movement_max : nat16;
  champion_id : text;
  skill_keys : vec text;
  army_stacks : vec ChampionArmyStackRecord;
  skill_points : nat16;
  class_key : text;
  strength_label : text;
  class_def_id : text;
  redacted : bool;
  effective_movement : nat16;
};
type ChangedSubject = record {
  subject_kind : text;
  operation : text;
  subject_id_text : text;
};
type CommandPhase = variant {
  EffectsApplied;
  Failed;
  Complete;
  Recovered;
  Created;
  Validated;
  EventsApplied;
  Applying;
};
type CommandResponse = record {
  status : CommandStatus;
  result : CommandResult;
  changed_subjects : vec ChangedSubject;
  command_id : text;
  error : opt ApiError;
  command_type : text;
  events : vec ApiEventView;
  effective_turn : nat32;
  actor_participant_id : opt text;
  actor_principal : principal;
  phase : CommandPhase;
  retryable : bool;
  client_nonce : text;
  durable_turn : nat32;
  payload_hash : text;
};
type CommandResult = variant {
  ChampionMagic : ChampionMagicReceipt;
  RecruitPreview : RecruitPreview;
  BuildPreview : BuildPreview;
  None;
  MovementSync : MovementSyncOutcome;
  BattleAction : BattleActionReceipt;
  WorldGeneration : WorldGenerationReceipt;
  MovementPreview : MovementPreview;
  BattleSync : BattleSyncOutcome;
  StrategicReceipt : StrategicCommandReceipt;
  ExpandedEconomy : ExpandedEconomyReceipt;
  AdvancedScenario : AdvancedScenarioReceipt;
};
type CommandStatus = variant {
  Applied;
  Failed;
  Superseded;
  AppliedNoop;
  Cancelled;
  Pending;
  Applying;
};
type CommandStatusView = record {
  status : CommandStatus;
  result_json : opt text;
  command_id : text;
  error_message : opt text;
  phase : CommandPhase;
  error_code : opt text;
  retryable : bool;
};
type ContentManifest = record {
  asset_keys : vec text;
  terrain : vec TerrainContent;
  factions : vec FactionContent;
  artifacts : vec ArtifactContent;
  champion_classes : vec ChampionClassContent;
  units : vec UnitContent;
  spells : vec SpellContent;
  ruleset : RulesetContent;
  map_objects : vec MapObjectContent;
  buildings : vec BuildingContent;
};
type ContentManifestResponse = record { manifest : ContentManifest };
type DamagePreview = record {
  max_damage : nat32;
  min_damage : nat32;
  estimated_kills_max : nat32;
  estimated_kills_min : nat32;
  target_stack_id : text;
};
type DataStoreSnapshot = record {
  memory_bytes : nat64;
  path : text;
  entries : nat64;
};
type DiagnosticProjectionFlushView = record {
  queue_len_after : nat64;
  entries_processed : nat64;
  stable_pages_delta : nat64;
  queue_len_before : nat64;
  flushed_at_ms : nat64;
  flush_truncated : bool;
  flush_instructions : nat64;
  rows_flushed : nat64;
};
type DiagnosticProjectionKernelView = record {
  dirty_queue_len : nat64;
  session_id : text;
  oldest_dirty_age_ms : opt nat64;
  lag_ms : nat64;
  lag_generations : nat64;
  flushed_at_ms : nat64;
  kernel_id : text;
  pending_entries : nat64;
  kernel_generation : nat64;
  turn_number : nat32;
  flushed_generation : nat64;
};
type DiagnosticProjectionSnapshot = record {
  oldest_dirty_age_ms : opt nat64;
  total_dirty_queue_len : nat64;
  last_flush : opt DiagnosticProjectionFlushView;
  kernels : vec DiagnosticProjectionKernelView;
};
type DiagnosticRowCount = record { entity : text; count : nat32 };
type DiagnosticStorageSnapshot = record {
  stable_memory_pages : nat64;
  total_rows : nat32;
  row_counts : vec DiagnosticRowCount;
};
type DiagnosticSystemJobPage = record {
  jobs : vec DiagnosticSystemJobView;
  limit : nat32;
  next_cursor : opt text;
};
type DiagnosticSystemJobView = record {
  last_error : opt text;
  status : text;
  due_at_ms : nat64;
  battle_id : opt text;
  session_id : text;
  command_id : opt text;
  job_key : text;
  lease_expires_at_ms : opt nat64;
  attempt_count : nat32;
  lease_owner : opt text;
  turn_number : opt nat32;
  job_kind : text;
  cursor_json : opt text;
};
type DwellingPoolView = record {
  owner_participant_id : opt text;
  direct_recruit : bool;
  growth_per_week : nat16;
  object_id : text;
  unit_slug : text;
  available : nat32;
  last_growth_week : nat32;
};
type DwellingRecruitPreview = record {
  target_champion_id : text;
  object_id : text;
  total_cost : ResourceBalances;
  allowed : bool;
  unit_slug : text;
  available : nat32;
  quantity : nat32;
  disabled_reason : opt text;
};
type EndpointKind = variant { Update; Query };
